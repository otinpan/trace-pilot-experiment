{"type":"edit_burst","uri":"/home/hase/trace-pilot-experiment/atcoder/AHC062/src/main.cpp","languageId":"cpp","ts_start":1779865886813,"ts_end":1779865886813,"before_version":1,"after_version":2,"stats":{"changeCount":1,"insertedChars":2001,"deletedChars":840,"insertedLinesApprox":65,"deletedLinesApprox":35},"changes":[{"range":{"start":{"line":7,"character":0},"end":{"line":42,"character":0}},"rangeOffset":132,"rangeLength":840,"text":"#include\"strategy/sorround.h\"\n#include\"simulator.h\"\nint map_size = 0;\n\nint main(){\n  int n;\n  std::cin>>n;\n\n  map_size = n;\n\n  std::vector<std::vector<int>> g(n,std::vector<int>(n));\n\n  for(int i=0;i<n;i++){\n    for(int j=0;j<n;j++){\n      std::cin>>g[i][j];\n    }\n  }\n\n  Logger horizontal_logger(\"horizontal.log\");\n  Logger vertical_logger(\"vertical.log\");\n  Logger sorround_clockwise_logger(\"sorround_clockwise.log\");\n  Logger sorround_counter_clockwise_logger(\"sorround_counter_clockwise.log\");\n\n  State horizontal_state(g);\n  State vertical_state(g);\n  State sorround_clockwise_state(g);\n  State sorround_counter_clockwise_state(g);\n\n  Greedy horizontal_strategy(false);\n  Greedy vertical_strategy(true);\n  Sorround sorround_clockwise_strategy(true);\n  Sorround sorround_counter_clockwise_strategy(false);\n\n  horizontal_logger.log(\"start\");\n  std::vector<Pos> horizontal_result=horizontal_strategy.solve(horizontal_state,horizontal_logger);\n\n  vertical_logger.log(\"start\");\n  std::vector<Pos> vertical_result=vertical_strategy.solve(vertical_state,vertical_logger);\n\n  sorround_clockwise_logger.log(\"start\");\n  std::vector<Pos> sorround_clockwise_result=sorround_clockwise_strategy.solve(\n    sorround_clockwise_state,\n    sorround_clockwise_logger\n  );\n\n  sorround_counter_clockwise_logger.log(\"start\");\n  std::vector<Pos> sorround_counter_clockwise_result=sorround_counter_clockwise_strategy.solve(\n    sorround_counter_clockwise_state,\n    sorround_counter_clockwise_logger\n  );\n\n  std::vector<Pos> result=horizontal_result;\n  long long best_score=horizontal_state.score();\n  if(vertical_state.score()>best_score){\n    best_score=vertical_state.score();\n    result=vertical_result;\n  }\n  if(sorround_clockwise_state.score()>best_score){\n    best_score=sorround_clockwise_state.score();\n    result=sorround_clockwise_result;\n  }\n  if(sorround_counter_clockwise_state.score()>best_score){\n    best_score=sorround_counter_clockwise_state.score();\n    result=sorround_counter_clockwise_result;\n  }\n"}],"diff_unified":"===================================================================\n--- main.cpp (before)\tsnapshot\n+++ main.cpp (after)\tidle\n@@ -4,8 +4,9 @@\n #include\"logger.h\"\n #include\"state.h\"\n #include\"strategy/strategy.h\"\n #include\"strategy/greedy.h\"\n+#include\"strategy/sorround.h\"\n #include\"simulator.h\"\n int map_size = 0;\n \n int main(){\n@@ -23,25 +24,54 @@\n   }\n \n   Logger horizontal_logger(\"horizontal.log\");\n   Logger vertical_logger(\"vertical.log\");\n+  Logger sorround_clockwise_logger(\"sorround_clockwise.log\");\n+  Logger sorround_counter_clockwise_logger(\"sorround_counter_clockwise.log\");\n \n   State horizontal_state(g);\n   State vertical_state(g);\n+  State sorround_clockwise_state(g);\n+  State sorround_counter_clockwise_state(g);\n \n   Greedy horizontal_strategy(false);\n   Greedy vertical_strategy(true);\n+  Sorround sorround_clockwise_strategy(true);\n+  Sorround sorround_counter_clockwise_strategy(false);\n \n   horizontal_logger.log(\"start\");\n   std::vector<Pos> horizontal_result=horizontal_strategy.solve(horizontal_state,horizontal_logger);\n \n   vertical_logger.log(\"start\");\n   std::vector<Pos> vertical_result=vertical_strategy.solve(vertical_state,vertical_logger);\n \n-  std::vector<Pos> result=horizontal_state.score()>=vertical_state.score()\n-    ? horizontal_result\n-    : vertical_result;\n+  sorround_clockwise_logger.log(\"start\");\n+  std::vector<Pos> sorround_clockwise_result=sorround_clockwise_strategy.solve(\n+    sorround_clockwise_state,\n+    sorround_clockwise_logger\n+  );\n \n+  sorround_counter_clockwise_logger.log(\"start\");\n+  std::vector<Pos> sorround_counter_clockwise_result=sorround_counter_clockwise_strategy.solve(\n+    sorround_counter_clockwise_state,\n+    sorround_counter_clockwise_logger\n+  );\n+\n+  std::vector<Pos> result=horizontal_result;\n+  long long best_score=horizontal_state.score();\n+  if(vertical_state.score()>best_score){\n+    best_score=vertical_state.score();\n+    result=vertical_result;\n+  }\n+  if(sorround_clockwise_state.score()>best_score){\n+    best_score=sorround_clockwise_state.score();\n+    result=sorround_clockwise_result;\n+  }\n+  if(sorround_counter_clockwise_state.score()>best_score){\n+    best_score=sorround_counter_clockwise_state.score();\n+    result=sorround_counter_clockwise_result;\n+  }\n+\n   for(const auto& res:result){\n     std::cout<<res.i<<\" \"<<res.j<<'\\n';\n   }\n \n"}
