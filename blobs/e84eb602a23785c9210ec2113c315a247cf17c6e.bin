{"type":"edit_burst","uri":"/home/hase/trace-pilot-experiment/atcoder/AHC062/src/strategy/sorround.cpp","languageId":"cpp","ts_start":1779867022830,"ts_end":1779867024451,"before_version":3907,"after_version":3908,"stats":{"changeCount":1,"insertedChars":1,"deletedChars":0,"insertedLinesApprox":0,"deletedLinesApprox":0},"changes":[{"range":{"start":{"line":119,"character":7},"end":{"line":119,"character":7}},"rangeOffset":2250,"rangeLength":0,"text":"!"}],"diff_unified":"===================================================================\n--- sorround.cpp (before)\tsnapshot\n+++ sorround.cpp (after)\tidle\n@@ -116,9 +116,9 @@\n     Direction::RIGHT,\n     Direction::LEFT\n   }){\n     Pos next=pos+DIRS[(int)dir];\n-    if(next.is_on_block(left_top,right_bottom)){\n+    if(!next.is_on_block(left_top,right_bottom)){\n       continue;\n     }\n     if(pre_dir==dir){\n       continue;\n"}
{"type":"edit_burst","uri":"/home/hase/trace-pilot-experiment/atcoder/AHC062/src/strategy/sorround.cpp","languageId":"cpp","ts_start":1779867150518,"ts_end":1779867150518,"before_version":3908,"after_version":3909,"stats":{"changeCount":1,"insertedChars":3272,"deletedChars":2387,"insertedLinesApprox":175,"deletedLinesApprox":129},"changes":[{"range":{"start":{"line":1,"character":0},"end":{"line":130,"character":1}},"rangeOffset":21,"rangeLength":2387,"text":"\nstd::pair<Pos,Pos> solve_next_block(\n  const Direction& pre_dir,\n  const Pos& pre_left_top,\n  const Pos& pre_right_bottom\n);\n\nDirection solve_turn_direction(\n  Pos& pos,\n  const Pos& left_top,\n  const Pos& right_bottom,\n  const Direction pre_dir\n);\n\nSurround::Surround()\n  :Strategy()\n  ,depth_(3)\n{\n\n}\n\nSurround::~Surround()=default;\nstd::vector<Pos> Surround::solve(State& state,Logger& logger){\n  logger.log(state);\n  Timer timer;\n  \n}\n\nlong long Surround::dfs(\n  State& state,\n  Logger& logger,\n  Pos pos,\n  Pos left_top,\n  Pos right_bottom,\n  Direction pre_dir,\n  int turn,\n  int n_depth\n){\n  (void)pre_dir;\n  if(n_depth==depth_){\n    return 0;\n  }\n\n  long long best=0;\n  for(Direction dir:{\n    Direction::UP,\n    Direction::DOWN,\n    Direction::RIGHT,\n    Direction::LEFT\n  }){\n    Pos next=pos+DIRS[static_cast<int>(dir)];\n    if(!next.is_on_block(left_top,right_bottom)){\n      continue;\n    }\n\n    Pos n_pos=pos;\n    int n_turn=turn;\n    long long line_score=score_straight(\n      state,\n      left_top,\n      right_bottom,\n      logger,\n      n_pos,\n      dir,\n      n_turn\n    );\n\n    bool can_turn=false;\n    for(Direction next_dir:{\n      Direction::UP,\n      Direction::DOWN,\n      Direction::RIGHT,\n      Direction::LEFT\n    }){\n      if(next_dir==dir)continue;\n\n      Pos turn_next=n_pos+DIRS[static_cast<int>(next_dir)];\n      if(turn_next.is_on_block(left_top,right_bottom)){\n        can_turn=true;\n        break;\n      }\n    }\n\n    long long candidate=line_score;\n    if(!can_turn){\n      if(candidate>best){\n        best=candidate;\n      }\n      continue;\n    }\n\n    // 曲がる\n    Direction turn_dir=solve_turn_direction(\n      n_pos,\n      left_top,\n      right_bottom,\n      dir\n    );\n    \n    // 曲がっただけscore\n    n_turn++;\n    line_score+=(long long)n_turn*state.kingdom()[n_pos.i][n_pos.j];\n    \n    // 次の区画を求める\n    std::pair<Pos,Pos> next_block=solve_next_block(\n      turn_dir,\n      left_top,\n      right_bottom\n    );\n\n    candidate=line_score+dfs(\n      state,\n      logger,\n      n_pos,\n      next_block.first,\n      next_block.second,\n      turn_dir,\n      n_turn,\n      n_depth+1\n    );\n\n    if(candidate>best){\n      best=candidate;\n    }\n  }\n\n  return best;\n}\n\nstd::pair<Pos,Pos> solve_next_block(\n  const Direction& pre_dir,\n  const Pos& pre_left_top,\n  const Pos& pre_right_bottom\n){\n  switch(pre_dir){\n    case Direction::UP:\n      return std::make_pair(pre_left_top,pre_right_bottom+Pos(-1,0));\n    case Direction::DOWN:\n      return std::make_pair(pre_left_top+Pos(1,0),pre_right_bottom);\n    case Direction::RIGHT:\n      return std::make_pair(pre_left_top+Pos(0,1),pre_right_bottom);\n    case Direction::LEFT:\n      return std::make_pair(pre_left_top,pre_right_bottom+Pos(0,-1));\n    default:\n      assert(0);\n      return std::make_pair(pre_left_top,pre_right_bottom);\n  }\n}\n\nDirection solve_turn_direction(\n  Pos& pos,\n  const Pos& left_top,\n  const Pos& right_bottom,\n  const Direction pre_dir\n){\n  for(Direction dir:{\n    Direction::UP,\n    Direction::DOWN,\n    Direction::RIGHT,\n    Direction::LEFT\n  }){\n    Pos next=pos+DIRS[(int)dir];\n    if(!next.is_on_block(left_top,right_bottom)){\n      continue;\n    }\n    if(pre_dir==dir){\n      continue;\n    }\n    pos=next;\n    return dir;\n  }\n\n  assert(0);\n  return Direction::UP;\n}\n"}],"diff_unified":"===================================================================\n