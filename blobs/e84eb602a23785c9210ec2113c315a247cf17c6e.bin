{"type":"edit_burst","uri":"/home/hase/trace-pilot-experiment/atcoder/AHC062/src/strategy/sorround.h","languageId":"cpp","ts_start":1779865836599,"ts_end":1779865836599,"before_version":1080,"after_version":1081,"stats":{"changeCount":1,"insertedChars":275,"deletedChars":329,"insertedLinesApprox":10,"deletedLinesApprox":18},"changes":[{"range":{"start":{"line":4,"character":9},"end":{"line":22,"character":2}},"rangeOffset":77,"rangeLength":329,"text":"\n    Sorround(bool clockwise=true);\n    ~Sorround() override;\n\n    std::vector<Pos> solve(State& state,Logger& logger) override;\n  private:\n    bool clockwise_;\n    std::vector<Pos> build_path() const;\n    Direction direction_between(const Pos& from,const Pos& to) const;\n};\n"}],"diff_unified":"===================================================================\n--- sorround.h (before)\tsnapshot\n+++ sorround.h (after)\tidle\n@@ -2,22 +2,13 @@\n #include\"strategy.h\"\n \n class Sorround: public Strategy{\n   public:\n-    Sorround();\n+    Sorround(bool clockwise=true);\n     ~Sorround() override;\n \n     std::vector<Pos> solve(State& state,Logger& logger) override;\n   private:\n-    int depth_=2;\n-    long long dfs(\n-      State& state,\n-      Logger& logger,\n-      Pos from,\n-      Pos left_top,\n-      Pos right_bottom,\n-      Direction pre_dir,\n-      int turn,\n-      int n_depth\n-    );\n-\n-};\n\\ No newline at end of file\n+    bool clockwise_;\n+    std::vector<Pos> build_path() const;\n+    Direction direction_between(const Pos& from,const Pos& to) const;\n+};\n"}
{"type":"file_created","uri":"/home/hase/trace-pilot-experiment/atcoder/AHC062/src/strategy/sorround.cpp","ts":1779865853870,"diff_unified":"===================================================================\n--- sorround.cpp (before)\tsnapshot\n+++ sorround.cpp (after)\tcreate\n@@ -0,0 +1,101 @@\n+#include\"sorround.h\"\n+\n+Sorround::Sorround(bool clockwise)\n+  :Strategy()\n+  ,clockwise_(clockwise)\n+{\n+\n+}\n+\n+Sorround::~Sorround()=default;\n+\n+std::vector<Pos> Sorround::solve(State& state,Logger& logger){\n+  std::vector<Pos> path=build_path();\n+  std::vector<Pos> result;\n+  if(path.empty()){\n+    return result;\n+  }\n+\n+  logger.log(state);\n+  result.emplace_back(state.pos());\n+\n+  for(size_t i=1;i<path.size();i++){\n+    Direction dir=direction_between(path[i-1],path[i]);\n+    if(!state.apply(dir)){\n+      return result;\n+    }\n+    result.emplace_back(state.pos());\n+    logger.log(state);\n+  }\n+\n+  return result;\n+}\n+\n+std::vector<Pos> Sorround::build_path() const{\n+  std::vector<Pos> path;\n+  int top=0;\n+  int left=0;\n+  int bottom=map_size-1;\n+  int right=map_size-1;\n+\n+  while(top<=bottom && left<=right){\n+    if(clockwise_){\n+      for(int j=left;j<=right;j++){\n+        path.emplace_back(top,j);\n+      }\n+      for(int i=top+1;i<=bottom;i++){\n+        path.emplace_back(i,right);\n+      }\n+      if(top<bottom){\n+        for(int j=right-1;j>=left;j--){\n+          path.emplace_back(bottom,j);\n+        }\n+      }\n+      if(left<right){\n+        for(int i=bottom-1;i>top;i--){\n+          path.emplace_back(i,left);\n+        }\n+      }\n+    }else{\n+      for(int i=top;i<=bottom;i++){\n+        path.emplace_back(i,left);\n+      }\n+      for(int j=left+1;j<=right;j++){\n+        path.emplace_back(bottom,j);\n+      }\n+      if(left<right){\n+        for(int i=bottom-1;i>=top;i--){\n+          path.emplace_back(i,right);\n+        }\n+      }\n+      if(top<bottom){\n+        for(int j=right-1;j>left;j--){\n+          path.emplace_back(top,j);\n+        }\n+      }\n+    }\n+\n+    top++;\n+    left++;\n+    bottom--;\n+    right--;\n+  }\n+\n+  return path;\n+}\n+\n+Direction Sorround::direction_between(const Pos& from,const Pos& to) const{\n+  Pos diff=to-from;\n+  for(Direction dir:{\n+    Direction::UP,\n+    Direction::RIGHT,\n+    Direction::DOWN,\n+    Direction::LEFT\n+  }){\n+    if(DIRS[static_cast<int>(dir)]==diff){\n+      return dir;\n+    }\n+  }\n+  assert(0);\n+  return Direction::UP;\n+}\n"}
{"type":"edit_burst","uri":"/home/hase/trace-pilot-experiment/atcoder/AHC062/src/strategy/sorround.cpp","languageId":"cpp","ts_start":1779865853903,"ts_end":1779865853903,"before_version":3747,"after_version":3748,"stats":{"changeCount":1,"insertedChars":1979,"deletedChars":2348,"insertedLinesApprox":100,"deletedLinesApprox":127},"changes":[{"range":{"start":{"line":1,"character":0},"end":{"line":128,"character":1}},"rangeOffset":21,"rangeLength":2348,"text":"\nSorround::Sorround(bool clockwise)\n  :Strategy()\n  ,clockwise_(clockwise)\n{\n\n}\n\nSorround::~Sorround()=default;\n\nstd::vector<Pos> Sorround::solve(State& state,Logger& logger){\n  std::vector<Pos> path=build_path();\n  std::vector<Pos> result;\n  if(path.empty()){\n    return result;\n  }\n\n  logger.log(state);\n  result.emplace_back(state.pos());\n\n  for(size_t i=1;i<path.size();i++){\n    Direction dir=direction_between(path[i-1],path[i]);\n    if(!state.apply(dir)){\n      return result;\n    }\n    result.emplace_back(state.pos());\n    logger.log(state);\n  }\n\n  return result;\n}\n\nstd::vector<Pos> Sorround::build_path() const{\n  std::vector<Pos> path;\n  int top=0;\n  int left=0;\n  int bottom=map_size-1;\n  int right=map_size-1;\n\n  while(top<=bottom && left<=right){\n    if(clockwise_){\n      for(int j=left;j<=right;j++){\n        path.emplace_back(top,j);\n      }\n      for(int i=top+1;i<=bottom;i++){\n        path.emplace_back(i,right);\n      }\n      if(top<bottom){\n        for(int j=right-1;j>=left;j--){\n          path.emplace_back(bottom,j);\n        }\n      }\n      if(left<right){\n        for(int i=bottom-1;i>top;i--){\n          path.emplace_back(i,left);\n        }\n      }\n    }else{\n      for(int i=top;i<=bottom;i++){\n        path.emplace_back(i,left);\n      }\n      for(int j=left+1;j<=right;j++){\n        path.emplace_back(bottom,j);\n      }\n      if(left<right){\n        for(int i=bottom-1;i>=top;i--){\n          path.emplace_back(i,right);\n        }\n      }\n      if(top<bottom){\n        for(int j=right-1;j>left;j--){\n          path.emplace_back(top,j);\n        }\n      }\n    }\n\n    top++;\n    left++;\n    bottom--;\n    right--;\n  }\n\n  return path;\n}\n\nDirection Sorround::direction_between(const Pos& from,const Pos& to) const{\n  Pos diff=to-from;\n  for(Direction dir:{\n    Direction::UP,\n    Direction::RIGHT,\n    Direction::DOWN,\n    Direction::LEFT\n  }){\n    if(DIRS[static_cast<int>(dir)]==diff){\n      return dir;\n    }\n  }\n  assert(0);\n  return Direction::UP;\n}\n"}],"diff_unified":"===================================================================\n--- sorround.cpp (before)\tsnapshot\n+++ sorround.cpp (after)\tidle\n@@ -1,129 +1,101 @@\n #include\"sorround.h\"\n \n-Sorround::Sorround()\n+Sorround::Sorround(bool clockwise)\n   :Strategy()\n-  ,depth_(3)\n+  ,clockwise_(clockwise)\n {\n \n }\n \n Sorround::~Sorround()=default;\n+\n std::vector<Pos> Sorround::solve(State& state,Logger& logger){\n+  std::vector<Pos> path=build_path();\n+  std::vector<Pos> result;\n+  if(path.empty()){\n+    return result;\n+  }\n+\n   logger.log(state);\n-  Timer timer;\n-  \n-}\n+  result.emplace_back(state.pos());\n \n-long long Sorround::dfs(\n-  State& state,\n-  Logger& logger,\n-  Pos pos,\n-  Pos left_top,\n-  Pos right_bottom,\n-  Direction pre_dir,\n-  int turn,\n-  int n_depth\n-){\n-  if(n_depth==depth_){\n-    return 0;\n+  for(size_t i=1;i<path.size();i++){\n+    Direction dir=direction_between(path[i-1],path[i]);\n+    if(!state.apply(dir)){\n+      return result;\n+    }\n+    result.emplace_back(state.pos());\n+    logger.log(state);\n   }\n \n-  long long best=0;\n-  for(Direction dir:{\n-    Direction::UP,\n-    Direction::DOWN,\n-    Direction::RIGHT,\n-    Direction::LEFT\n-  }){\n-    if(dir==pre_dir)continue;\n-    Pos next=pos+DIRS[static_cast<int>(dir)];\n-    if(next.is_on_block(left_top,right_bottom)){\n-      continue;\n-    }\n+  return result;\n+}\n \n-    Pos n_pos=pos;\n-    int n_turn=turn;\n-    long long line_score=score_straight(\n-      state,\n-      left_top,\n-      right_bottom,\n-      logger,\n-      n_pos,\n-      dir,\n-      n_turn\n-    );\n+std::vector<Pos> Sorround::build_path() const{\n+  std::vector<Pos> path;\n+  int top=0;\n+  int left=0;\n+  int bottom=map_size-1;\n+  int right=map_size-1;\n \n-    // 曲がる\n-    Direction turn_dir=solve_turn_direction(\n-      n_pos,\n-      left_top,\n-      right_bottom,\n-      dir\n-    );\n-    \n-    // 曲がっただけscore\n-    n_turn++;\n-    line_score+=(long long)state.kingdom()[n_pos.i][n_pos.j];\n-    \n-    // 次の区画を求める\n-    std::pair<Pos,Pos> next_block=solve_next_block(\n-      turn_dir,\n-      left_top,\n-      right_bottom\n-    );\n+  while(top<=bottom && left<=right){\n+    if(clockwise_){\n+      for(int j=left;j<=right;j++){\n+        path.emplace_back(top,j);\n+      }\n+      for(int i=top+1;i<=bottom;i++){\n+        path.emplace_back(i,right);\n+      }\n+      if(top<bottom){\n+        for(int j=right-1;j>=left;j--){\n+          path.emplace_back(bottom,j);\n+        }\n+      }\n+      if(left<right){\n+        for(int i=bottom-1;i>top;i--){\n+          path.emplace_back(i,left);\n+        }\n+      }\n+    }else{\n+      for(int i=top;i<=bottom;i++){\n+        path.emplace_back(i,left);\n+      }\n+      for(int j=left+1;j<=right;j++){\n+        path.emplace_back(bottom,j);\n+      }\n+      if(left<right){\n+        for(int i=bottom-1;i>=top;i--){\n+          path.emplace_back(i,right);\n+        }\n+      }\n+      if(top<bottom){\n+        for(int j=right-1;j>left;j--){\n+          path.emplace_back(top,j);\n+        }\n+      }\n+    }\n \n-    return line_score+dfs(\n-      state,\n-      logger,\n-      n_pos,\n-      next_block.first,\n-      next_block.second,\n-      turn_dir,\n-      n_turn,\n-      n_depth+1\n-    );\n+    top++;\n+    left++;\n+    bottom--;\n+    right--;\n   }\n-}\n \n-std::pair<Pos,Pos> solve_next_block(\n-  const Direction& pre_dir,\n-