(--background-color-base,#fff); }
  .vector-header-container { width: 100%; display: flex; justify-content: c=
enter; }
  .vector-header-container .mw-header, .vector-header-container .vector-sti=
cky-header { width: 100%; min-height: 3.125rem; background-color: var(--bac=
kground-color-base,#fff); min-width: 18.75em; max-width: 99.75rem; padding-=
left: 1.5rem; padding-right: 1.5rem; box-sizing: border-box; }
