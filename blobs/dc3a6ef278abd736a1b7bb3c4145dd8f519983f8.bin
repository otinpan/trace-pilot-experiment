  .vector-page-toolbar, .vector-header-start > :not(.mw-logo), .vector-head=
er-end, #mw-panel-toc, #vector-sticky-header, #p-lang-btn, .vector-menu-che=
ckbox, nav, #vector-page-titlebar-toc, #footer { display: none !important; =
