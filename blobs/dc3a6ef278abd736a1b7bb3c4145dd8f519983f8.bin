erif; }
  .mw-body a:not(.image) { border-bottom: 1px solid rgb(170, 170, 170); }
  .firstHeading { font-size: 25pt; line-height: 28pt; margin-bottom: 20px; =
padding-bottom: 5px; }
  .firstHeading, .mw-heading2, :not(.mw-heading2) h2 { overflow: hidden; bo=
rder-bottom: 2px solid var(--color-emphasized,#101418); }
  .mw-heading3, h3, .mw-heading4, h4, .mw-heading5, h5, .mw-heading6, h6 { =
margin: 30px 0px 0px; }
