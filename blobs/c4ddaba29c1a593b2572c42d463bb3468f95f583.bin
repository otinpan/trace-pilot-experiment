# Record 2: file:///home/hase/trace-pilot-experiment/atcoder/AHC063/src/experiment_logger.cpp
```diff
===================================================================
--- experiment_logger.cpp (before)	snapshot
+++ experiment_logger.cpp (after)	create
@@ -0,0 +1,34 @@
+#include"experiment_logger.h"
+#include<filesystem>
+
+ExperimentLogger::ExperimentLogger(const std::string& path){
+  const bool exists=std::filesystem::exists(path);
+  const bool has_content=
+    exists && std::filesystem::is_regular_file(path) &&
+    std::filesystem::file_size(path)>0;
+
+  ofs_.open(path,std::ios::app);
+
+  if(!has_content){
+    ofs_<<"start_temp,end_temp,best_score,elapsed,operation_count,snake_size,seed\n";
+  }
+}
+
+void ExperimentLogger::logSaResult(
+    double start_temp,
+    double end_temp,
+    int best_score,
+    double elapsed,
+    int operation_count,
+    int snake_size,
+    int seed
+){
+  ofs_
+    <<start_temp<<","
+    <<end_temp<<","
+    <<best_score<<","
+    <<elapsed<<","
+    <<operation_count<<","
+    <<snake_size<<","
+    <<seed<<"\n";
+}

```

