+      used[next.i][next.j]=true;
+      path.emplace_back(static_cast<Direction>(d));
+
+      int next_turn=turn+1;
+      ll next_score=score+1LL*next_turn*g[next.i][next.j];
+      self(self,next,next_turn,next_score);
