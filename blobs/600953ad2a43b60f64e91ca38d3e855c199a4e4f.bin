[{"id":"1778916675070-","time":1778916675074,"userMessage":"","botResponse":"アクセス修飾子によります。\n修飾子子クラスからアクセスpublic可能protected可能private不可\n\n例\nC++class Parent {public:    int a;protected:    int b;private:    int c;};\n\n子クラス\nC++class Child : public Parent {public:    void f() {        a = 1; // OK        b = 2; // OK        c = 3; // NG    }};\n\nprivate は完全に隠蔽\nParent の内部専用\nです。\n子でも触れません。\n\nprotected は「子専用公開」\n外部には隠すでも子には見せる\nです。\n\nただし設計的には注意\n初心者の頃は：\nprotected 便利！\nとなりやすいですが、\n実際は：\n子が親内部に依存しすぎる\n問題があります。\n\n現代C++では\nかなり：\nprivate + accessor\nが推奨です。\n\n例えば\nあまりおすすめでない\nC++class Strategy {protected:    State state_;};\n\nおすすめ\nC++class Strategy {private:    State state_;protected:    const State& state() const {        return state_;    }};\n\n今回の Strategy は？\n例えば：\nC++class Strategy {public:    virtual vector<char> solve(...) = 0;    virtual ~Strategy() = default;};\nなら、\nメンバ変数なし\nでも十分です。\n\nAHCでありがち\n実際かなり：\nC++class GreedyStrategy : public Strategy {};\nみたいに、\nStrategy は interface 的\nに使います。\n\nつまり\n親：\n共通API定義\n子：\n実装\nです。\n\nかなり重要\n継承は：\nコード共有\nより：\nインターフェース統一\n目的で使うことが多いです。","codeBlocks":[{"code":"class Parent {\npublic:\n    int a;\n\nprotected:\n    int b;\n\nprivate:\n    int c;\n};","codeRef":null,"copied":false,"surroundingText":"class Parent {\npublic:\n    int a;\n\nprotected:\n    int b;\n\nprivate:\n    int c;\n};","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"class Child : public Parent {\npublic:\n    void f() {\n        a = 1; // OK\n        b = 2; // OK\n        c = 3; // NG\n    }\n};","codeRef":null,"copied":false,"surroundingText":"class Child : public Parent {\npublic:\n    void f() {\n        a = 1; // OK\n        b = 2; // OK\n        c = 3; // NG\n    }\n};","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"Parent の内部専用","codeRef":null,"copied":false,"surroundingText":"Parent の内部専用","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"外部には隠す\nでも子には見せる","codeRef":null,"copied":false,"surroundingText":"外部には隠す\nでも子には見せる","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"protected 便利！","codeRef":null,"copied":false,"surroundingText":"protected 便利！","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"子が親内部に依存しすぎる","codeRef":null,"copied":false,"surroundingText":"子が親内部に依存しすぎる","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"private + accessor","codeRef":null,"copied":false,"surroundingText":"private + accessor","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"class Strategy {\nprotected:\n    State state_;\n};","codeRef":null,"copied":false,"surroundingText":"class Strategy {\nprotected:\n    State state_;\n};","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"class Strategy {\nprivate:\n    State state_;\n\nprotected:\n    const State& state() const {\n        return state_;\n    }\n};","codeRef":null,"copied":false,"surroundingText":"class Strategy {\nprivate:\n    State state_;\n\nprotected:\n    const State& state() const {\n        return state_;\n    }\n};","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"class Strategy {\npublic:\n    virtual vector<char> solve(...) = 0;\n\n    virtual ~Strategy() = default;\n};","codeRef":null,"copied":false,"surroundingText":"class Strategy {\npublic:\n    virtual vector<char> solve(...) = 0;\n\n    virtual ~Strategy() = default;\n};","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"メンバ変数なし","codeRef":null,"copied":false,"surroundingText":"メンバ変数なし","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"class GreedyStrategy : public Strategy {\n};","codeRef":null,"copied":false,"surroundingText":"class GreedyStrategy : public Strategy {\n};","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"Strategy は interface 的","codeRef":null,"copied":false,"surroundingText":"Strategy は interface 的","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"共通API定義","codeRef":null,"copied":false,"surroundingText":"共通API定義","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"実装","codeRef":null,"copied":false,"surroundingText":"実装","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"コード共有","codeRef":null,"copied":false,"surroundingText":"コード共有","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"},{"code":"インターフェース統一","codeRef":null,"copied":false,"surroundingText":"インターフェース統一","language":"","parentId":"1778916675070-","turnParentId":"b819b38f-0550-4b14-95d0-bc430d36146a"}]},{"id":"1778916675074-山登り法ではすべての遷移可能の状態から最高のものを選び続ける","time":1778916675077,"userMessage":"山登り法ではすべての遷移可能の状態から最高のものを選び続けるのか、ランダムに選んで高かったら遷移する、どちらもありますよね。decideとsolveはともに依存しますよね。これはどのようにして実装しますか","botResponse":"はい。山登り法は decide() だけ差し替える設計では足りない です。\nなぜなら、山登り法では「次の1手」ではなく、解全体や近傍解を評価して採用するからです。\nおすすめはこうです。\nC++class Strategy {public:    virtual ~Strategy() = default;    virtual std::vector<char> solve(        const State& initial_state,        const std::vector<Color>& ideal    ) = 0;};\n\n1. 貪欲法\n1手ずつ決める。\nC++class GreedyStrategy : public Strategy {public:    std::vector<char> solve(        const State& initial_state,        const std::vector<Color>& ideal    ) override {        State state = initial_state;        std::vector<char> ops;        for (int t = 0; t < 100000; t++) {            Direction dir = decide(state);            if (!state.apply(dir)) break;            ops.push_back(OUTPUT_DIR[(int)dir]);            if (state.snake().size() == ideal.size()) break;        }        return ops;    }private:    Direction decide(const State& state) {        for (Direction dir : ALL_DIRS) {            if (state.canApply(dir)) return dir;        }        return Direction::UP;    }};\n\n2. 山登り法\n操作列全体を持ち、近傍を作って、良ければ採用。\nC++class HillClimbingStrategy : public Strategy {public:    std::vector<char> solve(        const State& initial_state,        const std::vector<Color>& ideal    ) override {        std::vector<char> cur = makeInitialSolution(initial_state, ideal);        int cur_score = evaluate(initial_state, ideal, cur);        std::vector<char> best = cur;        int best_score = cur_score;        while (!timeLimit()) {            std::vector<char> next = cur;            // 例: ランダムに1手変更            int idx = randInt(0, (int)next.size() - 1);            next[idx] = randomDirChar();            int next_score = evaluate(initial_state, ideal, next);            // スコアは小さいほど良い            if (next_score < cur_score) {                cur = next;                cur_score = next_score;                if (cur_score < best_score) {                    best = cur;                    best_score = cur_score;                }            }        }        return best;    }};\n\nつまり設計は：\nState        : apply() で操作列をシミュレートできるEvaluator    : 操作列のスコアを計算するStrategy     : solve() で操作列を作る\nが良いです。\ndecide() は貪欲専用の補助関数として GreedyStrategy の中に置くのが自然です。\n山登り法・焼きなまし法では decide() という概念を無理に使わない方がいいです。","codeBlocks":[{"code":"class Strategy {\npublic:\n    virtual ~Strategy() = default;\n\n    virtual std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) = 0;\n};","codeRef":null,"copied":false,"surroundingText":"class Strategy {\npublic:\n    virtual ~Strategy() = default;\n\n    virtual std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) = 0;\n};","language":"","parentId":"1778916675074-山登り法ではすべての遷移可能の状態から最高のものを選び続ける","turnParentId":"e33eafaa-ed03-4c4a-a9e6-84492a925b6a"},{"code":"class GreedyStrategy : public Strategy {\npublic:\n    std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) override {\n        State state = initial_state;\n        std::vector<char> ops;\n\n        for (int t = 0; t < 100000; t++) {\n            Direction dir = decide(state);\n\n            if (!state.apply(dir)) break;\n\n            ops.push_back(OUTPUT_DIR[(int)dir]);\n\n            if (state.snake().size() == ideal.size()) break;\n        }\n\n        return ops;\n    }\n\nprivate:\n    Direction decide(const State& state) {\n        for (Direction dir : ALL_DIRS) {\n            if (state.canApply(dir)) return dir;\n        }\n        return Direction::UP;\n    }\n};","codeRef":null,"copied":false,"surroundingText":"class GreedyStrategy : public Strategy {\npublic:\n    std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) override {\n        State state = initial_state;\n        std::vector<char> ops;\n\n        for (int t = 0; t < 100000; t++) {\n            Direction dir = decide(state);\n\n            if (!state.apply(dir)) break;\n\n            ops.push_back(OUTPUT_DIR[(int)dir]);\n\n            if (state.snake().size() == ideal.size()) break;\n        }\n\n        return ops;\n    }\n\nprivate:\n    Direction decide(const State& state) {\n        for (Direction dir : ALL_DIRS) {\n            if (state.canApply(dir)) return dir;\n        }\n        return Direction::UP;\n    }\n};","language":"","parentId":"1778916675074-山登り法ではすべての遷移可能の状態から最高のものを選び続ける","turnParentId":"e33eafaa-ed03-4c4a-a9e6-84492a925b6a"},{"code":"class HillClimbingStrategy : public Strategy {\npublic:\n    std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) override {\n        std::vector<char> cur = makeInitialSolution(initial_state, ideal);\n        int cur_score = evaluate(initial_state, ideal, cur);\n\n        std::vector<char> best = cur;\n        int best_score = cur_score;\n\n        while (!timeLimit()) {\n            std::vector<char> next = cur;\n\n            // 例: ランダムに1手変更\n            int idx = randInt(0, (int)next.size() - 1);\n            next[idx] = randomDirChar();\n\n            int next_score = evaluate(initial_state, ideal, next);\n\n            // スコアは小さいほど良い\n            if (next_score < cur_score) {\n                cur = next;\n                cur_score = next_score;\n\n                if (cur_score < best_score) {\n                    best = cur;\n                    best_score = cur_score;\n                }\n            }\n        }\n\n        return best;\n    }\n};","codeRef":null,"copied":false,"surroundingText":"class HillClimbingStrategy : public Strategy {\npublic:\n    std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) override {\n        std::vector<char> cur = makeInitialSolution(initial_state, ideal);\n        int cur_score = evaluate(initial_state, ideal, cur);\n\n        std::vector<char> best = cur;\n        int best_score = cur_score;\n\n        while (!timeLimit()) {\n            std::vector<char> next = cur;\n\n            // 例: ランダムに1手変更\n            int idx = randInt(0, (int)next.size() - 1);\n            next[idx] = randomDirChar();\n\n            int next_score = evaluate(initial_state, ideal, next);\n\n            // スコアは小さいほど良い\n            if (next_score < cur_score) {\n                cur = next;\n                cur_score = next_score;\n\n                if (cur_score < best_score) {\n                    best = cur;\n                    best_score = cur_score;\n                }\n            }\n        }\n\n        return best;\n    }\n};","language":"","parentId":"1778916675074-山登り法ではすべての遷移可能の状態から最高のものを選び続ける","turnParentId":"e33eafaa-ed03-4c4a-a9e6-84492a925b6a"},{"code":"State        : apply() で操作列をシミュレートできる\nEvaluator    : 操作列のスコアを計算する\nStrategy     : solve() で操作列を作る","codeRef":null,"copied":false,"surroundingText":"State        : apply() で操作列をシミュレートできる\nEvaluator    : 操作列のスコアを計算する\nStrategy     : solve() で操作列を作る","language":"","parentId":"1778916675074-山登り法ではすべての遷移可能の状態から最高のものを選び続ける","turnParentId":"e33eafaa-ed03-4c4a-a9e6-84492a925b6a"}]}]