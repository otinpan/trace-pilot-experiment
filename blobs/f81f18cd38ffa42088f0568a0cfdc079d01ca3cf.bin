<pre class=3D"code lang-cpp" data-lang=3D"cpp" data-unlink=3D""><span class=
=3D"synComment">//=E7=8A=B6=E6=85=8B</span>
<span class=3D"synType">struct</span> STATE {
};

<span class=3D"synComment">// =E7=8A=B6=E6=85=8B=E3=81=AE=E5=88=9D=E6=9C=9F=
=E5=8C=96</span>
<span class=3D"synType">void</span> init (STATE&amp; state) {
}

<span class=3D"synComment">// =E7=8A=B6=E6=85=8B=E9=81=B7=E7=A7=BB</span>
<span class=3D"synType">void</span> modify (STATE&amp; state) {
}

<span class=3D"synComment">// =E7=8A=B6=E6=85=8B=E3=81=AE=E3=82=B9=E3=82=B3=
=E3=82=A2=E8=A8=88=E7=AE=97</span>
<span class=3D"synType">int</span> calc_score (STATE&amp; state) {
}

<span class=3D"synComment">// =E7=84=BC=E3=81=8D=E3=81=AA=E3=81=BE=E3=81=97=
=E6=B3=95</span>
<span class=3D"synType">void</span> sa() {
    STATE state;
    init(state);
    <span class=3D"synType">double</span> start_temp, end_temp; <span class=
=3D"synComment">// =E9=81=A9=E5=BD=93=E3=81=AA=E5=80=A4=E3=82=92=E5=85=A5=
=E3=82=8C=E3=82=8B=EF=BC=88=E5=BE=8C=E8=BF=B0=EF=BC=89</span>
    <span class=3D"synType">double</span> start_time; <span class=3D"synCom=
ment">// =E9=96=8B=E5=A7=8B=E6=99=82=E5=88=BB</span>
    <span class=3D"synStatement">while</span> (<span class=3D"synConstant">=
true</span>) { <span class=3D"synComment">// =E6=99=82=E9=96=93=E3=81=AE=E8=
=A8=B1=E3=81=99=E9=99=90=E3=82=8A=E5=9B=9E=E3=81=99</span>
        <span class=3D"synType">double</span> now_time; <span class=3D"synC=
omment">// =E7=8F=BE=E5=9C=A8=E6=99=82=E5=88=BB</span>
        <span class=3D"synStatement">if</span> (now_time - start_time &gt; =
TIME_LIMIT) <span class=3D"synStatement">break</span>;

        STATE new_state =3D state;
        modify(new_state);
        <span class=3D"synType">int</span> new_score =3D calc_score(new_sta=
te);
        <span class=3D"synType">int</span> pre_score =3D calc_score(state);

        <span class=3D"synComment">// =E6=B8=A9=E5=BA=A6=E9=96=A2=E6=95=B0<=
/span>
        <span class=3D"synType">double</span> temp =3D start_temp + (end_te=
mp - start_temp) * (now_time-start_time) / TIME_LIMIT;
        <span class=3D"synComment">// =E9=81=B7=E7=A7=BB=E7=A2=BA=E7=8E=87=
=E9=96=A2=E6=95=B0(=E6=9C=80=E5=A4=A7=E5=8C=96=E3=81=AE=E5=A0=B4=E5=90=88)<=
/span>
        <span class=3D"synType">double</span> prob =3D exp((new_score-pre_s=
core)/temp);

        <span class=3D"synStatement">if</span> (prob &gt; (rand()%INF)/(<sp=
an class=3D"synType">double</span>)INF) { <span class=3D"synComment">// =E7=
=A2=BA=E7=8E=87prob=E3=81=A7=E9=81=B7=E7=A7=BB=E3=81=99=E3=82=8B</span>
            state =3D new_state;
        }
    }
}
