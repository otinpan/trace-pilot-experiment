@charset "utf-8";

article, aside, details, figcaption, figure, footer, header, hgroup, nav, s=
ection, summary { display: block; }

audio, canvas, video { display: inline-block; }

audio:not([controls]) { display: none; height: 0px; }

[hidden] { display: none; }

html { font-family: sans-serif; text-size-adjust: 100%; }

body { margin: 0px; }

a:focus { outline: dotted thin; }

a:active, a:hover { outline: 0px; }

h1 { font-size: 2em; }

abbr[title] { border-bottom: 1px dotted; }

b, strong { font-weight: 700; }

dfn { font-style: italic; }

mark { background: rgb(255, 255, 0); color: rgb(0, 0, 0); }

code, kbd, pre, samp { font-family: monospace, serif; font-size: 1em; }

pre { white-space: pre-wrap; overflow-wrap: break-word; }

q { quotes: "=E2=80=9C" "=E2=80=9D" "=E2=80=98" "=E2=80=99"; }

small { font-size: 80%; }

sub, sup { font-size: 75%; line-height: 0; position: relative; vertical-ali=
gn: baseline; }

sup { top: -0.5em; }

sub { bottom: -0.25em; }

img { border: 0px; }

svg:not(:root) { overflow: hidden; }

figure { margin: 0px; }

fieldset { border: 1px solid rgb(192, 192, 192); margin: 0px 2px; padding: =
0.35em 0.625em 0.75em; }

legend { border: 0px; padding: 0px; }

button, input, select, textarea { font-family: inherit; font-size: 100%; ma=
rgin: 0px; }

button, input { line-height: normal; }

button, html input[type=3D"button"], input[type=3D"reset"], input[type=3D"s=
ubmit"] { appearance: button; cursor: pointer; }

button[disabled], input[disabled] { cursor: default; }

input[type=3D"checkbox"], input[type=3D"radio"] { box-sizing: border-box; p=
adding: 0px; }

input[type=3D"search"] { appearance: textfield; box-sizing: content-box; }

input[type=3D"search"]::-webkit-search-cancel-button, input[type=3D"search"=
]::-webkit-search-decoration { appearance: none; }

textarea { overflow: auto; vertical-align: top; }

table { border-collapse: collapse; border-spacing: 0px; }

.clearfix { display: block; }

.clearfix::after { display: block; visibility: hidden; font-size: 0px; heig=
ht: 0px; clear: both; content: "."; }

.inline-block { display: inline-block; }

.ellipsis { white-space: nowrap; text-overflow: ellipsis; overflow: hidden;=
 }

.font-default { font-family: "Helvetica Neue", Helvetica, Arial, "=E3=83=92=
=E3=83=A9=E3=82=AE=E3=83=8E=E8=A7=92=E3=82=B4 Pro W3", "Hiragino Kaku Gothi=
c Pro", =E3=83=A1=E3=82=A4=E3=83=AA=E3=82=AA, Meiryo, "=EF=BC=AD=EF=BC=B3 =
=EF=BC=B0=E3=82=B4=E3=82=B7=E3=83=83=E3=82=AF", "MS PGothic", sans-serif; }

.border-box { box-sizing: border-box; }

.center { text-align: center; margin-left: auto; margin-right: auto; }

.left { float: left; }

.right { float: right; }

.nofloat { float: none; }

.clear { clear: both; }

.block { display: block; }

.inline { display: inline; }

.nodisplay { display: none; }

.relative { position: relative; }

.absolute { position: absolute; }

.static { position: static; }

.fixed { position: fixed; }

.margin0 { margin: 0px !important; }

.padding0 { padding: 0px !important; }

.bold { font-weight: 700; }

.normal { font-weight: 400; font-style: normal; }

.thin { font-weight: 300; }

.italic { font-style: italic; }

.nodeco { text-decoration: none; }

.underline { text-decoration: underline; }

.nolist { list-style-type: none; }

.disc { list-style-type: disc; }

.circle { list-style-type: circle; }

.textleft { text-align: left; }

.textright { text-align: right; }

ul, ol { margin: 0px; padding-left: 0px; }

nav ul { list-style: none; }

iframe { margin: 0px; padding: 0px; border: 0px; outline: 0px; }

.hide { display: none; }

a { color: rgb(14, 106, 206); text-decoration: none; }

a:hover { text-decoration: underline; }

p { margin: 0px; padding: 0px; line-height: 1.7; }

span.small, span.smaller { font-size: 70%; }

.navbar { margin-bottom: 30px; height: 35px; display: block; border-bottom:=
 1px solid rgb(210, 216, 221); }

.navbar::after { display: block; visibility: hidden; font-size: 0px; height=
: 0px; clear: both; content: "."; }

.navbar li { list-style: none; float: left; font-size: 14px; }

.navbar li.active a, .navbar li.ui-tabs-active a { box-shadow: rgb(45, 149,=
 222) 0px -3px 0px -1px inset; }

.navbar a { display: inline-block; padding: 0px 15px; line-height: 35px; co=
lor: rgb(61, 66, 69); }

.navbar a:hover { color: rgb(45, 149, 222); text-decoration: none; }

.navbar a.none { pointer-events: none; }

.navbar li.navbar-right { float: right; }

.navbar .navbtn-register a { background: rgb(37, 171, 93); }

.navbar .navbtn-register a:hover { background: rgb(30, 137, 75); }

.breadcrumb { padding: 8px 15px; margin: 0px 0px 20px; list-style: none; bo=
rder-radius: 4px; background-clip: padding-box; font-size: 13px; color: rgb=
(107, 115, 119); border: 1px solid rgb(210, 216, 221); }

.breadcrumb > li { display: inline-block; text-shadow: rgb(255, 255, 255) 0=
px 1px 0px; }

.breadcrumb > li > .divider { padding: 0px 5px; color: rgb(204, 204, 204); =
}

form table, .table { width: 100%; color: rgb(61, 66, 69); line-height: 1.5;=
 margin-bottom: 10px; border-collapse: collapse; }

form table th, .table th, form table td, .table td { padding: 10px; }

form table th, .table th, form table td, .table td { border-style: solid; b=
order-color: rgb(210, 216, 221); border-width: 1px 0px; }

form table th, .table th { text-align: left; vertical-align: middle; }

form table td.submit, .table td.submit { border-color: transparent !importa=
nt; padding: 8px 0px !important; }

form table p, .table p, form table .note, .table .note { color: rgb(107, 11=
5, 119); margin: 1em 0px; }

form table p:first-child, .table p:first-child, form table .note:first-chil=
d, .table .note:first-child { margin-top: 0px; }

form table td.bold, .table td.bold { width: 20%; }

form table tr.border-top-none, .table tr.border-top-none, form table th.bor=
der-top-none, .table th.border-top-none, form table td.border-top-none, .ta=
ble td.border-top-none { border-top: none !important; }

form table h3, .table h3 { font-weight: 700; font-size: 110%; margin: 0px 0=
px 1em; line-height: 1.3; }

form table h4, .table h4 { font-weight: 700; margin: 0px 0px 0.8em; line-he=
ight: 1.3; }

form table .text-bigger, .table .text-bigger { font-size: 125%; }

form table .text-bold, .table .text-bold { font-weight: 700; }

form table img, .table img { vertical-align: middle; }

form table ul, .table ul { margin: 0px; padding-left: 0px; }

form table ul ul, .table ul ul { margin: 0px; }

form table td.profile-image img, .table td.profile-image img { vertical-ali=
gn: baseline; }

form table ul.radioform li, .table ul.radioform li { margin: 10px 0px; }

form table ul.radioform li:first-child, .table ul.radioform li:first-child =
{ margin-top: 0px; }

form table ul.radioform li:last-child, .table ul.radioform li:last-child { =
margin-bottom: 0px; }

form table label, .table label { font-weight: 700; }

form table label + .note, .table label + .note { margin-top: 0.5em; }

form table span.radio, .table span.radio, form table label.radio, .table la=
bel.radio { font-weight: 700; font-size: 14px; margin-right: 10px; margin-l=
eft: 2px; }

form table.middle th, .table.middle th, form table.middle td, .table.middle=
 td { vertical-align: middle; }

form table tr.disabled th, .table tr.disabled th, form table tr.disabled td=
, .table tr.disabled td { opacity: 0.5; }

table.table-2column { width: 49%; }

table.table-2column th { width: 150px; }

ol.list, ul.list { color: rgb(61, 66, 69); margin-bottom: 10px; }

ol.list li, ul.list li { padding: 8px 0px; border-bottom: 1px solid rgb(210=
, 216, 221); list-style: none; }

ol.list li:first-child, ul.list li:first-child { padding-top: 0px; }

ol.list li:last-child, ul.list li:last-child { border-bottom: 0px; padding-=
bottom: 0px; }

