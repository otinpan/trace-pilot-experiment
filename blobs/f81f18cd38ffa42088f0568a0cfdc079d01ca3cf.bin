@charset "utf-8";

@import url("https://fonts.googleapis.com/css?family=3DPT+Sans:400,400i,700=
,700i");

html { font-family: sans-serif; line-height: 1.15; text-size-adjust: 100%; =
}

body { margin: 0px; }

article, aside, footer, header, nav, section { display: block; }

h1 { font-size: 2em; margin: 0.67em 0px; }

figcaption, figure, main { display: block; }

figure { margin: 1em 40px; }

hr { box-sizing: content-box; height: 0px; overflow: visible; }

pre { font-family: monospace, monospace; font-size: 1em; }

a { background-color: transparent; }

a:active, a:hover { outline-width: 0px; }

abbr[title] { border-bottom: none; text-decoration: underline dotted; }

b, strong { font-weight: inherit; }

b, strong { font-weight: bolder; }

code, kbd, samp { font-family: monospace, monospace; font-size: 1em; }

dfn { font-style: italic; }

mark { background-color: rgb(255, 255, 0); color: rgb(0, 0, 0); }

small { font-size: 80%; }

sub, sup { font-size: 75%; line-height: 0; position: relative; vertical-ali=
gn: baseline; }

sub { bottom: -0.25em; }

sup { top: -0.5em; }

audio, video { display: inline-block; }

audio:not([controls]) { display: none; height: 0px; }

img { border-style: none; }

svg:not(:root) { overflow: hidden; }

button, input, optgroup, select, textarea { font-family: sans-serif; font-s=
ize: 100%; line-height: 1.15; margin: 0px; }

button, input { overflow: visible; }

button, select { text-transform: none; }

button, html [type=3D"button"], [type=3D"reset"], [type=3D"submit"] { appea=
rance: button; }

fieldset { border: 1px solid rgb(192, 192, 192); margin: 0px 2px; padding: =
0.35em 0.625em 0.75em; }

legend { box-sizing: border-box; color: inherit; display: table; max-width:=
 100%; padding: 0px; white-space: normal; }

progress { display: inline-block; vertical-align: baseline; }

textarea { overflow: auto; }

[type=3D"checkbox"], [type=3D"radio"] { box-sizing: border-box; padding: 0p=
x; }

[type=3D"number"]::-webkit-inner-spin-button, [type=3D"number"]::-webkit-ou=
ter-spin-button { height: auto; }

[type=3D"search"] { appearance: textfield; outline-offset: -2px; }

[type=3D"search"]::-webkit-search-cancel-button, [type=3D"search"]::-webkit=
-search-decoration { appearance: none; }

::-webkit-file-upload-button { appearance: button; font: inherit; }

details, menu { display: block; }

summary { display: list-item; }

canvas { display: inline-block; }

template { display: none; }

[hidden] { display: none; }

.clearfix::after { content: " "; display: table; clear: both; }

html, body { font-family: "PT Sans", "Helvetica Neue", Arial, "Hiragino Kak=
u Gothic Pro", Meiryo, "MS PGothic", sans-serif; color: rgb(61, 63, 68); ba=
ckground-color: rgb(255, 255, 255); }

body { overflow-x: hidden; }

@media (min-width: 768px) {
  body.globalheader-off { padding-top: 1.5em; padding-bottom: 1.5em; }
  body.globalheader-off #container-inner { margin-top: 0px; }
}

a { color: rgb(86, 132, 215); }

a:hover { color: rgb(48, 103, 203); }

h1, h2, h3, h4, h5, h6 { color: rgb(46, 48, 52); }

h1 a, h2 a, h3 a, h4 a, h5 a, h6 a { color: rgb(46, 48, 52); text-decoratio=
n: none; }

h1 a:hover, h2 a:hover, h3 a:hover, h4 a:hover, h5 a:hover, h6 a:hover { co=
lor: rgb(48, 103, 203); }

#globalheader-container { position: sticky; top: 0px; color: rgb(61, 63, 68=
); background-color: rgb(255, 255, 255); }

#container, #footer { padding-left: 10px; padding-right: 10px; }

@media (min-width: 768px) {
  #container, #footer { width: 720px; margin: auto; padding-left: 0px; padd=
ing-right: 0px; }
}

@media (min-width: 1020px) {
  #container, #footer { width: 960px; }
}

#container { background: rgb(255, 255, 255); line-height: 1.5; overflow-wra=
p: break-word; }

@media (min-width: 768px) {
  #container-inner { padding: 1.5em; margin-top: 1.5em; }
}

#blog-title { text-align: center; margin: 0px; padding-bottom: 1.5em; paddi=
ng-top: 1em; }

@media (min-width: 481px) {
  #blog-title { padding-bottom: 1.5em; padding-top: 2em; }
}

@media (min-width: 768px) {
  #blog-title { margin: 1.5em 0px 0px; padding-top: 0px; }
}

@media (min-width: 768px) {
  .page-index #blog-title { margin: 3em 0px 0px; padding-bottom: 2em; }
}

#title { font-size: 1rem; }

@media (min-width: 768px) {
  #title { font-size: 1.1rem; }
}

.page-index #title { font-size: 1.2rem; }

@media (min-width: 768px) {
  .page-index #title { font-size: 1.3rem; }
}

#blog-description { font-size: 0.7rem; font-weight: 400; color: rgb(149, 15=
6, 158); }

@media (min-width: 768px) {
  #blog-description { font-size: 0.8rem; }
}

.page-index #blog-description { font-size: 0.8rem; }

.header-image-enable #blog-title, .header-image-only #blog-title { margin: =
0px -10px; padding-bottom: 1.5em; padding-top: 0px; }

@media (min-width: 768px) {
  .header-image-enable #blog-title, .header-image-only #blog-title { margin=
: 0px auto; }
}

.header-image-enable #blog-title #blog-title-inner, .header-image-only #blo=
g-title #blog-title-inner { display: flex; align-items: center; justify-con=
tent: center; height: 50vw; max-height: 200px; }

.header-image-enable #blog-title-content, .header-image-only #blog-title-co=
ntent { margin: 0px 0.5em; }

#top-editarea { margin: 0px auto 1em; }

#top-box { margin: 0px auto 1.5em; }

.breadcrumb { font-size: 0.85rem; color: rgb(149, 156, 158); }

@media (min-width: 768px) {
  #content { padding-top: 1em; }
}

@media (min-width: 768px) {
  .page-index #content { padding-top: 2em; }
}

.entry { margin-bottom: 3em; }

@media (min-width: 768px) {
  .entry { margin-bottom: 6em; }
}

.entry-header { text-align: center; position: relative; margin-bottom: 2em;=
 }

.entry-header-menu { position: absolute; top: 0px; right: 0px; }

.entry-header-menu a { display: inline-block; text-align: center; cursor: p=
ointer; line-height: 1.5; overflow: hidden; color: rgb(61, 63, 68); backgro=
und-color: transparent; border: 1px solid rgb(210, 215, 229); transition: 0=
.2s; padding: 0.2em 0.5em; font-size: 0.75rem; text-decoration: none !impor=
tant; }

.entry-header-menu a:hover { color: rgb(61, 63, 68); background-color: rgb(=
247, 248, 249); text-decoration: none; border-color: rgb(178, 186, 210); }

.entry-header-menu a img, .entry-header-menu a svg { vertical-align: top; m=
argin-right: 0.3em; }

.date { font-size: 0.8rem; }

.date a { text-decoration: none; color: rgb(149, 156, 158); }

.date a:hover { color: rgb(48, 103, 203); }

.date-last-updated { color: rgb(149, 156, 158); font-size: 0.8rem; }

.entry-title { font-size: 1.3rem; font-weight: 400; margin: 0.4em 0px; }

@media (min-width: 768px) {
  .entry-title { font-size: 1.5rem; }
}

.page-entry .entry-title { font-size: 1.6rem; }

@media (min-width: 768px) {
  .page-entry .entry-title { font-size: 1.8rem; }
}

@media (min-width: 1020px) {
  .page-entry .entry-title { font-size: 2rem; }
}

.entry-categories { margin: 0.8em 0px; }

.categories a { display: inline-block; text-align: center; cursor: pointer;=
 line-height: 1.5; overflow: hidden; color: rgb(61, 63, 68); background-col=
or: transparent; border: 1px solid rgb(210, 215, 229); transition: 0.2s; pa=
dding: 0.2em 0.5em; font-size: 0.75rem; margin: 0px 0.1em; text-decoration:=
 none !important; }

.categories a:hover { color: rgb(61, 63, 68); background-color: rgb(247, 24=
8, 249); text-decoration: none; border-color: rgb(178, 186, 210); }

.categories a img, .categories a svg { vertical-align: top; margin-right: 0=
.3em; }

.customized-header { margin: 0.8em 0px; }

.entry-content, .entry-footer { margin: auto; }

@media (min-width: 768px) {
