+inline Direction get_direction(const Pos& from,const Pos& to){
+  Pos diff=to-from;
+  for(int i=0;i<static_cast<int>(DIRS.size());i++){
+    if(DIRS[i]==diff){
+      return static_cast<Direction>(i);
+    }
+  }
+  assert(false);
+  return Direction::UP;
+}
