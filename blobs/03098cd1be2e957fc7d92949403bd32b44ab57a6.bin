+
+Direction opposite_direction(Direction dir){
+  switch(dir){
+    case Direction::UP:
+      return Direction::DOWN;
+    case Direction::DOWN:
+      return Direction::UP;
+    case Direction::RIGHT:
+      return Direction::LEFT;
+    case Direction::LEFT:
+      return Direction::RIGHT;
+    default:
+      assert(0);
+      return Direction::UP;
+  }
+}

