# Record 1: file:///home/hase/trace-pilot-experiment/atcoder/AHC062/src/strategy/greedy.cpp
```diff
===================================================================
--- greedy.cpp (before)	snapshot
+++ greedy.cpp (after)	idle
@@ -15,8 +15,25 @@
 std::vector<Pos> Greedy::solve_zigzag(State& state,Logger& logger){
   std::vector<Pos> result;
   logger.log(state);
   result.emplace_back(state.pos());
+  for(int i=0;i<map_size;i++){
+    Direction dir=i%2==0 ? Direction::RIGHT : Direction::LEFT;
+    for(int j=0;j<map_size-1;j++){
+      if(!state.apply(dir)){
+        return result;
+      }
+      result.emplace_back(state.pos());
+      logger.log(state);
+    }
+
+    if(i!=map_size-1){
+      if(!state.apply(Direction::DOWN)){
+        return result;
+      }
+      result.emplace_back(state.pos());
+      logger.log(state);
+    }
   }
 
   return result;
 }

```

