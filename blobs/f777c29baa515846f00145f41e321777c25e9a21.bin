[{"id":"1778916960946-","time":1778916960950,"userMessage":"","botResponse":"はい。山登り法は decide() だけ差し替える設計では足りない です。\nなぜなら、山登り法では「次の1手」ではなく、解全体や近傍解を評価して採用するからです。\nおすすめはこうです。\nC++class Strategy {public:    virtual ~Strategy() = default;    virtual std::vector<char> solve(        const State& initial_state,        const std::vector<Color>& ideal    ) = 0;};\n\n1. 貪欲法\n1手ずつ決める。\nC++class GreedyStrategy : public Strategy {public:    std::vector<char> solve(        const State& initial_state,        const std::vector<Color>& ideal    ) override {        State state = initial_state;        std::vector<char> ops;        for (int t = 0; t < 100000; t++) {            Direction dir = decide(state);            if (!state.apply(dir)) break;            ops.push_back(OUTPUT_DIR[(int)dir]);            if (state.snake().size() == ideal.size()) break;        }        return ops;    }private:    Direction decide(const State& state) {        for (Direction dir : ALL_DIRS) {            if (state.canApply(dir)) return dir;        }        return Direction::UP;    }};\n\n2. 山登り法\n操作列全体を持ち、近傍を作って、良ければ採用。\nC++class HillClimbingStrategy : public Strategy {public:    std::vector<char> solve(        const State& initial_state,        const std::vector<Color>& ideal    ) override {        std::vector<char> cur = makeInitialSolution(initial_state, ideal);        int cur_score = evaluate(initial_state, ideal, cur);        std::vector<char> best = cur;        int best_score = cur_score;        while (!timeLimit()) {            std::vector<char> next = cur;            // 例: ランダムに1手変更            int idx = randInt(0, (int)next.size() - 1);            next[idx] = randomDirChar();            int next_score = evaluate(initial_state, ideal, next);            // スコアは小さいほど良い            if (next_score < cur_score) {                cur = next;                cur_score = next_score;                if (cur_score < best_score) {                    best = cur;                    best_score = cur_score;                }            }        }        return best;    }};\n\nつまり設計は：\nState        : apply() で操作列をシミュレートできるEvaluator    : 操作列のスコアを計算するStrategy     : solve() で操作列を作る\nが良いです。\ndecide() は貪欲専用の補助関数として GreedyStrategy の中に置くのが自然です。\n山登り法・焼きなまし法では decide() という概念を無理に使わない方がいいです。","codeBlocks":[{"code":"class Strategy {\npublic:\n    virtual ~Strategy() = default;\n\n    virtual std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) = 0;\n};","codeRef":null,"copied":false,"surroundingText":"class Strategy {\npublic:\n    virtual ~Strategy() = default;\n\n    virtual std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) = 0;\n};","language":"","parentId":"1778916960946-","turnParentId":"e33eafaa-ed03-4c4a-a9e6-84492a925b6a"},{"code":"class GreedyStrategy : public Strategy {\npublic:\n    std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) override {\n        State state = initial_state;\n        std::vector<char> ops;\n\n        for (int t = 0; t < 100000; t++) {\n            Direction dir = decide(state);\n\n            if (!state.apply(dir)) break;\n\n            ops.push_back(OUTPUT_DIR[(int)dir]);\n\n            if (state.snake().size() == ideal.size()) break;\n        }\n\n        return ops;\n    }\n\nprivate:\n    Direction decide(const State& state) {\n        for (Direction dir : ALL_DIRS) {\n            if (state.canApply(dir)) return dir;\n        }\n        return Direction::UP;\n    }\n};","codeRef":null,"copied":false,"surroundingText":"class GreedyStrategy : public Strategy {\npublic:\n    std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) override {\n        State state = initial_state;\n        std::vector<char> ops;\n\n        for (int t = 0; t < 100000; t++) {\n            Direction dir = decide(state);\n\n            if (!state.apply(dir)) break;\n\n            ops.push_back(OUTPUT_DIR[(int)dir]);\n\n            if (state.snake().size() == ideal.size()) break;\n        }\n\n        return ops;\n    }\n\nprivate:\n    Direction decide(const State& state) {\n        for (Direction dir : ALL_DIRS) {\n            if (state.canApply(dir)) return dir;\n        }\n        return Direction::UP;\n    }\n};","language":"","parentId":"1778916960946-","turnParentId":"e33eafaa-ed03-4c4a-a9e6-84492a925b6a"},{"code":"class HillClimbingStrategy : public Strategy {\npublic:\n    std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) override {\n        std::vector<char> cur = makeInitialSolution(initial_state, ideal);\n        int cur_score = evaluate(initial_state, ideal, cur);\n\n        std::vector<char> best = cur;\n        int best_score = cur_score;\n\n        while (!timeLimit()) {\n            std::vector<char> next = cur;\n\n            // 例: ランダムに1手変更\n            int idx = randInt(0, (int)next.size() - 1);\n            next[idx] = randomDirChar();\n\n            int next_score = evaluate(initial_state, ideal, next);\n\n            // スコアは小さいほど良い\n            if (next_score < cur_score) {\n                cur = next;\n                cur_score = next_score;\n\n                if (cur_score < best_score) {\n                    best = cur;\n                    best_score = cur_score;\n                }\n            }\n        }\n\n        return best;\n    }\n};","codeRef":null,"copied":false,"surroundingText":"class HillClimbingStrategy : public Strategy {\npublic:\n    std::vector<char> solve(\n        const State& initial_state,\n        const std::vector<Color>& ideal\n    ) override {\n        std::vector<char> cur = makeInitialSolution(initial_state, ideal);\n        int cur_score = evaluate(initial_state, ideal, cur);\n\n        std::vector<char> best = cur;\n        int best_score = cur_score;\n\n        while (!timeLimit()) {\n            std::vector<char> next = cur;\n\n            // 例: ランダムに1手変更\n            int idx = randInt(0, (int)next.size() - 1);\n            next[idx] = randomDirChar();\n\n            int next_score = evaluate(initial_state, ideal, next);\n\n            // スコアは小さいほど良い\n            if (next_score < cur_score) {\n                cur = next;\n                cur_score = next_score;\n\n                if (cur_score < best_score) {\n                    best = cur;\n                    best_score = cur_score;\n                }\n            }\n        }\n\n        return best;\n    }\n};","language":"","parentId":"1778916960946-","turnParentId":"e33eafaa-ed03-4c4a-a9e6-84492a925b6a"},{"code":"State        : apply() で操作列をシミュレートできる\nEvaluator    : 操作列のスコアを計算する\nStrategy     : solve() で操作列を作る","codeRef":null,"copied":false,"surroundingText":"State        : apply() で操作列をシミュレートできる\nEvaluator    : 操作列のスコアを計算する\nStrategy     : solve() で操作列を作る","language":"","parentId":"1778916960946-","turnParentId":"e33eafaa-ed03-4c4a-a9e6-84492a925b6a"}]},{"id":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","time":1778916960953,"userMessage":"struct STATE {\n};\n\n// 状態の初期化\nvoid init (STATE& state) {\n}\n\n// 状態遷移\nvoid modify (STATE& state) {\n}\n\n// 状態のスコア計算\nint calc_score (STATE& state) {\n}\n\n// 山登り法\nvoid mountain() {\n    STATE state;\n    init(state);\n    double start_time; // 開始時刻\n    while (true) { // 時間の許す限り回す\n        double now_time; // 現在時刻\n        if (now_time - start_time > TIME_LIMIT) break;\n\n        STATE new_state = state;\n        modify(new_state);\n        int new_score = calc_score(new_state);\n        int pre_score = calc_score(state);\n\n        if (new_score > pre_score) { // スコア最大化の場合\n            state = new_state;\n        }\n    }\n}\n\nこのように時間を表すのはどうやるのですか","botResponse":"C++ では普通：\nC++std::chrono\nを使います。\nAHC でもかなり典型です。\n\n一番よくある書き方\nC++#include <chrono>const double TIME_LIMIT = 1.95;double getTime() {    using namespace std::chrono;    static auto start =        high_resolution_clock::now();    auto now =        high_resolution_clock::now();    return duration<double>(now - start).count();}\n\n使い方\nC++void mountain() {    STATE state;    init(state);    while (true) {        double now_time = getTime();        if (now_time > TIME_LIMIT) {            break;        }        STATE new_state = state;        modify(new_state);        int new_score =            calc_score(new_state);        int pre_score =            calc_score(state);        if (new_score > pre_score) {            state = new_state;        }    }}\n\nduration<double>\nC++duration<double>(now - start).count()\nは：\n秒\nです。\n例えば：\n1.234567\nみたいに返ります。\n\nstatic start の意味\nC++static auto start = ...\nなので：\n最初の1回だけ記録\nされます。\nつまり：\nプログラム開始時刻\nっぽく使えます。\n\nAHCで超典型\nかなり：\nC++double getTime()\n関数を作ります。\n\nより高速な版\nLinux系では：\nC++#include <sys/time.h>double getTime() {    timeval tv;    gettimeofday(&tv, nullptr);    return tv.tv_sec         + tv.tv_usec * 1e-6;}\nもあります。\n\nでも chrono 推奨\n最近は：\nC++std::chrono\nが普通。\n\n焼きなましでは超重要\n例えば：\nC++double progress =    now_time / TIME_LIMIT;\nで：\n温度を徐々に下げる\nします。\n\n例\nC++double temp =    start_temp    + (end_temp - start_temp)    * progress;\n\nAHCでかなりよくあるテンプレ\nC++#include <chrono>class Timer {public:    Timer() {        start_ =            std::chrono::high_resolution_clock::now();    }    double elapsed() const {        using namespace std::chrono;        auto now =            high_resolution_clock::now();        return duration<double>(now - start_).count();    }private:    std::chrono::high_resolution_clock::time_point start_;};\n\n使い方\nC++Timer timer;while (timer.elapsed() < 1.95) {}\nかなり綺麗です。","codeBlocks":[{"code":"std::chrono","codeRef":null,"copied":false,"surroundingText":"std::chrono","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"#include <chrono>\n\nconst double TIME_LIMIT = 1.95;\n\ndouble getTime() {\n    using namespace std::chrono;\n\n    static auto start =\n        high_resolution_clock::now();\n\n    auto now =\n        high_resolution_clock::now();\n\n    return duration<double>(now - start).count();\n}","codeRef":null,"copied":false,"surroundingText":"#include <chrono>\n\nconst double TIME_LIMIT = 1.95;\n\ndouble getTime() {\n    using namespace std::chrono;\n\n    static auto start =\n        high_resolution_clock::now();\n\n    auto now =\n        high_resolution_clock::now();\n\n    return duration<double>(now - start).count();\n}","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"void mountain() {\n\n    STATE state;\n    init(state);\n\n    while (true) {\n\n        double now_time = getTime();\n\n        if (now_time > TIME_LIMIT) {\n            break;\n        }\n\n        STATE new_state = state;\n\n        modify(new_state);\n\n        int new_score =\n            calc_score(new_state);\n\n        int pre_score =\n            calc_score(state);\n\n        if (new_score > pre_score) {\n            state = new_state;\n        }\n    }\n}","codeRef":null,"copied":false,"surroundingText":"void mountain() {\n\n    STATE state;\n    init(state);\n\n    while (true) {\n\n        double now_time = getTime();\n\n        if (now_time > TIME_LIMIT) {\n            break;\n        }\n\n        STATE new_state = state;\n\n        modify(new_state);\n\n        int new_score =\n            calc_score(new_state);\n\n        int pre_score =\n            calc_score(state);\n\n        if (new_score > pre_score) {\n            state = new_state;\n        }\n    }\n}","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"duration<double>(now - start).count()","codeRef":null,"copied":false,"surroundingText":"duration<double>(now - start).count()","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"秒","codeRef":null,"copied":false,"surroundingText":"秒","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"1.234567","codeRef":null,"copied":false,"surroundingText":"1.234567","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"static auto start = ...","codeRef":null,"copied":false,"surroundingText":"static auto start = ...","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"最初の1回だけ記録","codeRef":null,"copied":false,"surroundingText":"最初の1回だけ記録","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"プログラム開始時刻","codeRef":null,"copied":false,"surroundingText":"プログラム開始時刻","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"double getTime()","codeRef":null,"copied":false,"surroundingText":"double getTime()","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"#include <sys/time.h>\n\ndouble getTime() {\n    timeval tv;\n    gettimeofday(&tv, nullptr);\n\n    return tv.tv_sec\n         + tv.tv_usec * 1e-6;\n}","codeRef":null,"copied":false,"surroundingText":"#include <sys/time.h>\n\ndouble getTime() {\n    timeval tv;\n    gettimeofday(&tv, nullptr);\n\n    return tv.tv_sec\n         + tv.tv_usec * 1e-6;\n}","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"std::chrono","codeRef":null,"copied":false,"surroundingText":"std::chrono","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"double progress =\n    now_time / TIME_LIMIT;","codeRef":null,"copied":false,"surroundingText":"double progress =\n    now_time / TIME_LIMIT;","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"温度を徐々に下げる","codeRef":null,"copied":false,"surroundingText":"温度を徐々に下げる","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"double temp =\n    start_temp\n    + (end_temp - start_temp)\n    * progress;","codeRef":null,"copied":false,"surroundingText":"double temp =\n    start_temp\n    + (end_temp - start_temp)\n    * progress;","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"#include <chrono>\n\nclass Timer {\npublic:\n    Timer() {\n        start_ =\n            std::chrono::high_resolution_clock::now();\n    }\n\n    double elapsed() const {\n        using namespace std::chrono;\n\n        auto now =\n            high_resolution_clock::now();\n\n        return duration<double>(now - start_).count();\n    }\n\nprivate:\n    std::chrono::high_resolution_clock::time_point start_;\n};","codeRef":null,"copied":false,"surroundingText":"#include <chrono>\n\nclass Timer {\npublic:\n    Timer() {\n        start_ =\n            std::chrono::high_resolution_clock::now();\n    }\n\n    double elapsed() const {\n        using namespace std::chrono;\n\n        auto now =\n            high_resolution_clock::now();\n\n        return duration<double>(now - start_).count();\n    }\n\nprivate:\n    std::chrono::high_resolution_clock::time_point start_;\n};","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"},{"code":"Timer timer;\n\nwhile (timer.elapsed() < 1.95) {\n}","codeRef":null,"copied":false,"surroundingText":"Timer timer;\n\nwhile (timer.elapsed() < 1.95) {\n}","language":"","parentId":"1778916960950-struct STATE {\n};\n\n// 状態の初期化\nv","turnParentId":"0fd032f7-83d2-4190-aac8-59742a1ea9f5"}]}]